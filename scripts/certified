#!/usr/bin/env ruby
# frozen_string_literal: true

# Reproduces the certified values of A070911 (twice the minimum area) and
# A063984 (minimum number of interior points) for every number of vertices
# from 3 up to a chosen largest number, with one validated optimal polygon
# for each.
#
#   scripts/certified LARGEST [--threads T] [--jobs J] [--memory-cap-mib M]
#                             [--spill DIR] [--out DIR]
#
# 1. Upper bounds: the modular solver (modular/) computes the heuristic box
#    optimum for every number of vertices up to LARGEST, as parallel
#    single-threaded jobs.
# 2. Certificate: certify/ runs once, up to LARGEST, with those bounds. Its
#    finished layers go to --spill (about 23 GB for 300 vertices and 337 GB
#    for 511; use a large disk) and are removed at the end.
# 3. Tables: OUT/b070911.txt, OUT/b063984.txt and OUT/a070911_polygons.txt,
#    with every polygon re-validated, then compared with data/.
# Measured on a 20-thread desktop CPU: up to 300 vertices in about 20
# minutes, up to 511 vertices in about 10 hours.

require 'optparse'
require_relative 'lib/common'
require_relative 'lib/modular_jobs'

options = { threads: Etc.nprocessors, jobs: Etc.nprocessors, cap: 14_336,
            spill: File.expand_path('spill'), out: File.expand_path('reproduced') }
OptionParser.new do |o|
  o.banner = 'Usage: scripts/certified LARGEST [options]'
  o.on('--threads T', Integer, 'threads for the certificate (default: all CPUs)') { |v| options[:threads] = v }
  o.on('--jobs J', Integer, 'parallel upper-bound jobs (default: all CPUs)') { |v| options[:jobs] = v }
  o.on('--memory-cap-mib M', Integer, 'memory for upper-bound jobs (default 14336)') { |v| options[:cap] = v }
  o.on('--spill DIR', 'directory for finished layers (default ./spill)') { |v| options[:spill] = File.expand_path(v) }
  o.on('--out DIR', 'output directory (default ./reproduced)') { |v| options[:out] = File.expand_path(v) }
end.parse!
abort 'Usage: scripts/certified LARGEST [options]' unless ARGV.size == 1 && ARGV.first.to_i.between?(3, 1000)
largest = ARGV.first.to_i
$stdout.sync = true
Repro.build!

out = options[:out]
FileUtils.mkdir_p(out)
puts "upper bounds for 3..#{largest} vertices"
bounds = ModularJobs.new(File.join(out, 'upper'), jobs: options[:jobs], cap_mib: options[:cap]).run(3..largest)
upper = File.join(out, 'upper.txt')
File.write(upper, (3..largest).map { |n| "#{n} #{bounds.fetch(n).fetch('doubled_area')}\n" }.join)

puts "certificate for 3..#{largest} vertices"
polygons = File.join(out, 'polygons')
summary = File.join(out, 'certify.json')
ok = system(Repro::BIN[:certify], '--k', largest.to_s, '--threads', options[:threads].to_s, '--upper', upper,
            '--spill', options[:spill], '--save', polygons, out: summary)
abort 'certificate run failed (rerun with --resume support: see certify --help)' unless ok

areas = JSON.parse(File.read(summary)).fetch('areas2_from_3')
rows = areas.each_with_index.map do |area2, i|
  n = i + 3
  points = Repro.read_polygon(File.join(polygons, format('k%06d.txt', n)), n)
  Repro.check!(n, area2, points)
  [n, area2, points]
end
header = "# Certified minima for 3..#{largest} vertices, reproduced by scripts/certified.\n"
Repro.write_tables(out, '', header, rows)
puts "tables written to #{out}"
same = Repro.same?('certified V(n)', rows.to_h { |n, a, _| [n, a] },
                   Repro.read_bfile(File.join(Repro::ROOT, 'data/b070911.txt')))
exit(same ? 0 : 1)
